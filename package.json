{
  "name": "@yedoma-labs/sir-forms",
  "version": "0.3.2",
  "description": "Type-safe React Server Actions form library with progressive enhancement",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "keywords": [
    "forms",
    "react",
    "server-actions",
    "zod",
    "validation",
    "progressive-enhancement",
    "server-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yedoma-labs/sir-forms"
  },
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "25.9.3",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "react": "^19.2.7",
    "semantic-release": "^25.0.9",
    "simple-git-hooks": "^2.13.1",
    "terser": "^5.48.0",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^5.0.3"
  }
}
